{
  "name": "daily-dump",
  "productName": "蔥頭",
  "version": "0.3.0",
  "description": "寫作時的剪下暫存區：每天一頁，把剪掉的段落先丟進來，幾天內要用再撈回去。",
  "main": "src/main.js",
  "author": "DOMYWEB",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "npm run build && electron .",
    "test": "node scripts/test-store.js",
    "design": "node scripts/sync-design.mjs",
    "design:check": "node scripts/sync-design.mjs --check",
    "pack": "npm run build && electron-packager . \"蔥頭\" --platform=win32 --arch=x64 --out=dist --overwrite --icon=assets/icon.ico --ignore=\"^/(dist|scripts|web|shots|\\.uiux-win|node_modules)\" --ignore=\"app\\.src\\.js$\"",
    "build": "esbuild src/renderer/app.src.js --bundle --format=iife --minify --target=chrome120 --outfile=src/renderer/app.js",
    "web": "npm run build && node scripts/build-web.js && node -e \"require('fs').copyFileSync('web/index.html','docs/index.html')\""
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@tiptap/core": "^2.27.3",
    "@tiptap/extension-image": "^2.27.3",
    "@tiptap/extension-link": "^2.27.3",
    "@tiptap/extension-placeholder": "^2.27.3",
    "@tiptap/extension-table": "^2.27.3",
    "@tiptap/extension-table-cell": "^2.27.3",
    "@tiptap/extension-table-header": "^2.27.3",
    "@tiptap/extension-table-row": "^2.27.3",
    "@tiptap/extension-task-item": "^2.27.3",
    "@tiptap/extension-task-list": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "electron": "^45.3.2",
    "esbuild": "^0.28.2",
    "tiptap-markdown": "^0.8.10"
  }
}